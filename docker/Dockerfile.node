# Multi-stage Dockerfile for EdgeMesh Monorepo Microservices
FROM node:22-alpine AS base

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# Copy root manifest and workspace settings
COPY package.json pnpm-workspace.yaml tsconfig.json ./

# Copy all package manifests for Docker layer caching
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/logger/package.json ./packages/logger/
COPY apps/origin/package.json ./apps/origin/
COPY apps/registry/package.json ./apps/registry/
COPY apps/routing-engine/package.json ./apps/routing-engine/
COPY apps/gateway/package.json ./apps/gateway/
COPY apps/edge-node/package.json ./apps/edge-node/
COPY apps/dashboard/package.json ./apps/dashboard/
COPY apps/client/package.json ./apps/client/

# Install dependencies (cached unless dependencies change)
RUN pnpm install --frozen-lockfile=false

# Copy remaining source code
COPY packages ./packages
COPY apps ./apps

# Build all TypeScript packages & apps
RUN pnpm --recursive run build

EXPOSE 3000 3001 3002 4001 4002 4003 5000

CMD ["node", "dist/index.js"]
